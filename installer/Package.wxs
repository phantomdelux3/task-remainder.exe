<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Per-user install: no administrator rights needed, installs to %LOCALAPPDATA%\Programs.
    Uninstalling removes the app's settings key (HKCU\Software\MarqueeReminder), which resets a
    forgotten app password. Reminders live in %APPDATA%\MarqueeReminder and are kept.
  -->
  <Package Name="Marquee Reminder"
           Manufacturer="deadpool1555"
           Version="$(var.ProductVersion)"
           UpgradeCode="7C1E4B52-9A3D-4F0B-8E26-5D8A1B3C9F41"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\MarqueeReminder\Resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Developed by deadpool1555" />

    <!-- Setup screens carrying the developer mark (artwork made by assets\make-branding.ps1). -->
    <UIRef Id="MarqueeReminderUI" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\Banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Developed by deadpool1555. Marquee Reminder is now running in the notification area (system tray) and will start with Windows." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Marquee Reminder" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <Component Id="App" Directory="INSTALLFOLDER" Guid="3B8F6C1D-2E4A-4C7B-9F0E-6A5D8C2B1E47">
        <File Id="AppExe" Source="$(var.MarqueeReminder.TargetDir)MarqueeReminder.exe" />
        <File Id="AppConfig" Source="$(var.MarqueeReminder.TargetDir)MarqueeReminder.exe.config" />
        <File Id="CoreDll" Source="$(var.MarqueeReminder.TargetDir)MarqueeReminder.Core.dll" />

        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="Marquee Reminder"
                  Target="[#AppExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <!-- Start with Windows, minimized to the tray. Removed again on uninstall. -->
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="MarqueeReminder"
                       Type="string"
                       Value="&quot;[#AppExe]&quot; --minimized" />

        <!-- Per-user components must use a registry value as their key path. -->
        <RegistryValue Root="HKCU" Key="Software\MarqueeReminder\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />

        <!-- Uninstalling deletes the app's settings, including the app password. -->
        <RemoveRegistryKey Root="HKCU" Key="Software\MarqueeReminder" Action="removeOnUninstall" />

        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </Feature>

    <!-- The app refuses to quit without its password, so the installer closes it when upgrading or uninstalling. -->
    <util:CloseApplication Id="CloseRunningApp"
                           Target="MarqueeReminder.exe"
                           CloseMessage="yes"
                           TerminateProcess="1"
                           RebootPrompt="no" />

    <!-- Start the app once installation finishes. -->
    <CustomAction Id="LaunchApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]MarqueeReminder.exe&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>

  <!--
    A short setup wizard: Welcome -> Ready to install -> Progress -> Finish. It is the standard
    WixUI_Minimal flow without the licence-agreement page, since there is no licence to accept.
  -->
  <Fragment>
    <UI Id="MarqueeReminderUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
